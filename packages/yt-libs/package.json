{
	"name": "@yt/libs",
	"version": "3.1.0",
	"description": "通用工具函数库 - 包含地址格式化等实用工具",
	"type": "module",
	"source": "src/index.ts",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"require": "./src/index.ts"
		},
		"./http": {
			"types": "./src/http/client.ts",
			"import": "./src/http/client.ts",
			"require": "./src/http/client.ts"
		}
	},
	"publishConfig": {
		"main": "./dist/index.cjs",
		"module": "./dist/index.mjs",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.mjs",
				"require": "./dist/index.cjs"
			},
			"./http": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.mjs",
				"require": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"build": "microbundle",
		"dev": "microbundle watch",
		"prepublishOnly": "pnpm run build"
	},
	"keywords": [
		"utils",
		"utilities",
		"web3",
		"address",
		"format",
		"typescript"
	],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"axios": "^1.7.7"
	},
	"devDependencies": {
		"microbundle": "^0.15.1",
		"typescript": "~5.7.2"
	}
}
