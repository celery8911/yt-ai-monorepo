		"viem": "^2.21.7",
		"wagmi": "^2.14.9"
	},
	"dependencies": {
		"immer": "^11.1.3"
	},
	"devDependencies": {
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.3.0",
		"@rainbow-me/rainbowkit": "^2.2.0",
		"@tanstack/react-query": "^5.59.20",
		"@types/react": "^19.0.6",
		"@types/react-dom": "^19.0.2",
		"rollup": "^4.54.0",
		"rollup-plugin-peer-deps-external": "^2.2.4",
