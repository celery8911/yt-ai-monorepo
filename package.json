{
	"name": "yt-ai-monorepo",
	"version": "1.0.0",
	"description": "AI-Native Monorepo 工程平台",
	"main": "index.js",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "biome lint .",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "turbo run build && changeset publish",
		"release:local": "turbo run build && changeset publish --registry http://localhost:4873/ --no-git-checks",
		"format": "biome format --write .",
		"check": "biome check .",
		"prepare": "husky install",
		"dev-test": "turbo run dev --filter=./apps/agents --filter=./apps/back-end --filter=./apps/front-end"
	},
	"keywords": [],
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/celery8911/yt-ai-monorepo.git"
	},
	"packageManager": "pnpm@10.28.0",
	"author": "",
	"license": "ISC",
	"type": "commonjs",
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"@changesets/cli": "^2.29.8",
		"husky": "^9.1.7",
		"lint-staged": "^15.2.11",
		"pino-pretty": "^10.3.1",
		"turbo": "^2.7.2"
	},
	"lint-staged": {
		"**/*.{js,jsx,ts,tsx}": "biome check --write --no-errors-on-unmatched",
		"**/*.{json,md,yml,yaml}": "biome format --write --no-errors-on-unmatched --files-ignore-unknown=true"
	}
}
