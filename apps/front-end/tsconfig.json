{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "preserve",
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		},
		"moduleResolution": "bundler",
		"noEmit": true,
		"declaration": false,
		"allowJs": true,
		"incremental": true,
		"types": ["node"],
		"plugins": [
			{
				"name": "next"
			}
		]
	},
	"include": ["next-env.d.ts", "src/**/*", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}
