{
	"name": "yt-back-end",
	"version": "0.1.0",
	"private": true,
	"type": "commonjs",
	"main": "dist/main.js",
	"scripts": {
		"predev": "prisma generate --schema prisma/schema.prisma",
		"dev": "nest start --watch",
		"build": "nest build",
		"start": "node dist/main.js",
		"keeper": "tsx src/keeper/cli.ts",
		"test": "tsx --test src/**/*.test.ts",
		"prisma:generate": "prisma generate --schema prisma/schema.prisma",
		"prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
		"seed": "ts-node src/seed/index.ts",
		"predeploy": "prisma generate --schema prisma/schema.prisma && pnpm build && node scripts/copy-prisma.js",
		"deploy": "serverless deploy",
		"deploy:dev": "pnpm predeploy && serverless deploy --stage dev",
		"deploy:prod": "pnpm predeploy && serverless deploy --stage prod",
		"remove": "serverless remove",
		"start:local": "pnpm build && serverless offline"
	},
	"dependencies": {
		"@nestjs/axios": "^3.0.2",
		"axios": "^1.7.2",
		"@codegenie/serverless-express": "^4.15.0",
		"@nestjs/apollo": "^12.0.11",
		"@nestjs/bull": "^10.2.1",
		"@nestjs/common": "^10.3.10",
		"@nestjs/core": "^10.3.10",
		"@nestjs/graphql": "^12.0.11",
		"@nestjs/platform-express": "^10.3.10",
		"@prisma/client": "^5.18.0",
		"@supabase/supabase-js": "^2.48.1",
		"bull": "^4.12.1",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"ethers": "^6.16.0",
		"express": "^4.21.2",
		"graphql": "^16.9.0",
		"ioredis": "^5.5.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"tslib": "^2.6.2"
	},
	"devDependencies": {
		"@nestjs/cli": "^10.4.2",
		"@nestjs/schematics": "^10.1.2",
		"@types/aws-lambda": "^8.10.145",
		"@types/express": "^5.0.0",
		"@types/node": "^20.14.12",
		"esbuild": "^0.20.0",
		"prisma": "^5.18.0",
		"serverless": "^4.7.3",
		"serverless-esbuild": "^1.52.0",
		"serverless-offline": "^14.4.0",
		"ts-node": "^10.9.2",
		"tsx": "^4.19.4",
		"typescript": "^5.5.4"
	}
}
